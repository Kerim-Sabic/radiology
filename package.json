{
  "name": "radiology-monster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal radiology learning workstation: real DICOM practice, spatial feedback, same-patient comparison and Learning Radiology (5th ed.) curriculum anchors.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.server.json",
    "preview": "vite preview --port 4317",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:validate": "vitest run tests/catalog.test.ts",
    "packs:list": "python scripts/data/packs.py list"
  },
  "dependencies": {
    "@clerk/backend": "3.26.4",
    "@clerk/react": "6.18.3",
    "@cornerstonejs/core": "5.13.2",
    "@cornerstonejs/dicom-image-loader": "5.13.2",
    "@cornerstonejs/metadata": "5.13.2",
    "@cornerstonejs/tools": "5.13.2",
    "@cornerstonejs/utils": "5.13.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@kitware/vtk.js": "36.4.1",
    "@upstash/redis": "1.40.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.4",
    "@whop/elements": "1.9.0",
    "@whop/elements-react": "1.9.0",
    "@whop/sdk": "2.6.0",
    "dicom-parser": "1.8.21",
    "events": "3.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "jose": "6.2.13",
    "lucide-react": "1.62.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
