{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "https://whop.com/.well-known/apple-platform-integrator/apple-developer-merchantid-domain-association"
    },
    {
      "source": "/verify/:id",
      "destination": "/api/index?__rvm_path=certificate-page&id=:id"
    },
    {
      "source": "/certificate/:id",
      "destination": "/api/index?__rvm_path=certificate-page&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__rvm_path=:path*"
    },
    {
      "source": "/((?!api/|_vercel/|assets/|packs/|content/|favicon|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(packs|content|book)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vary",
          "value": "Cookie"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/packs/:path*",
      "/content/:path*"
    ]
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 7 * * 1"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/certificate-data.json.gz,server/fonts/**,server/brand/**,node_modules/@resvg/resvg-wasm/index_bg.wasm,node_modules/harfbuzzjs/*.wasm}"
    }
  }
}
