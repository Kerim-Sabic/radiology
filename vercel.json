{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|assets/|packs/|content/|favicon).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    { "source": "/(packs|content)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/packs/(.*)/dicom/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/dicom" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    { "source": "/packs/(.*).json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/content/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
