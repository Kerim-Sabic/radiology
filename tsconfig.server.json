{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["server", "api", "proxy.ts"]
}
