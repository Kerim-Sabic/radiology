# Copy to .env.local for local builds, or set in your Netlify/Vercel project settings. All optional.

# Where large data packs are served from. Default: same origin /packs/.
VITE_PACK_BASE_URL=
# Optional URL of YOUR protected copy of the textbook PDF (must be on an access-protected origin).
# Leave empty to use public/book/ (private local builds) or to import the PDF per device.
VITE_BOOK_URL=
